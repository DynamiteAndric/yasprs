# Copy to .env and adjust
# LAN IP of the machine running Docker (the PS4 downloads packages from it)
HOST_IP=192.168.1.100
# Folder on the host containing your .pkg files
PKG_DIR=/path/to/pkgs
# Port for the web UI and package downloads
PORT=3001
# User/group IDs the app runs as (check with `id` / `ls -ln` on PKG_DIR)
PUID=1000
PGID=1000
